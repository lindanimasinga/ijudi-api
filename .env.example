# Local development environment variables for ijudi-api.
# Copy this file to .env and fill in real values, or export each variable in your shell profile.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage (macOS / Linux):
#   export STORE_SCOPE_JWT_SECRET=local-dev-secret-for-testing-only-min-32-chars
#   export SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/izinga-dev
#   ./mvnw test
#
# NOTE: the test suite does NOT require STORE_SCOPE_JWT_SECRET to be exported because
#   izinga-ordermanager/src/test/resources/application.yml already carries a literal
#   test-only secret for the unit-test context. You only need this export when running
#   the application itself (./mvnw spring-boot:run) locally.

# SEC-WA02-01-B: dedicated store-scope JWT signing secret.
# Must be at least 32 characters. Never use a production value here.
# UAT/prod value is provisioned via AWS Secrets Manager (key: izinga-uat / izinga-prod).
STORE_SCOPE_JWT_SECRET=local-dev-secret-for-testing-only-min-32-chars

# MongoDB connection — local dev.
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/izinga-dev
